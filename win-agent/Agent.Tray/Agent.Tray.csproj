    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AniGamesReady.Agent.Tray</AssemblyName>
    <RootNamespace>AniGamesReady.Agent.Tray</RootNamespace>
    <Version>0.2.5</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agent.Shared\Agent.Shared.csproj" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
    <PackageReference Include="TesseractOCR.Languages.English" Version="1.0.0" />
  </ItemGroup>
</Project>
